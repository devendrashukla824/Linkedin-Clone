{
  "name": "linkedin-clone-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "postcss": "8.5.15"
  },
  "scripts": {
    "dev": "npm run dev --workspace @linkedin-clone/web",
    "dev:web": "npm run dev --workspace @linkedin-clone/web",
    "dev:api": "npm run dev --workspace @linkedin-clone/api",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "test": "jest --runInBand",
    "test:e2e": "playwright test",
    "typecheck": "npm run typecheck --workspaces",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/supertest": "^7.2.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "prettier": "^3.3.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "typescript": "^5.6.3"
  }
}
